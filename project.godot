; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="RiftShards"
config/version="alpha 1.0.0"
run/main_scene="uid://q284yvww1mvj"
config/use_custom_user_dir=true
config/custom_user_dir_name="RiftShards"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/bg_color=Color(0.16078432, 0.16078432, 0.16078432, 1)
boot_splash/show_image=false
config/icon="uid://urw4b2r0t31l"

[autoload]

SettingsManager="*res://Scripts/settings manager.gd"
SceneManager="*res://Scripts/scene manager.gd"
SaveManager="*res://Scripts/save manager.gd"
ButtonAudio="*res://Assets/Sounds/button_sound.tscn"
DevControl="*res://Scenes/dev_control.tscn"
CraftingDB="*res://Scripts/crafting recipes.gd"
FoodDB="*res://Scripts/food data.gd"

[debug]

shapes/render_collision_shapes=true

[display]

window/size/mode=3
window/stretch/mode="viewport"
mouse_cursor/custom_image="uid://bwpn6l83kh6jm"
window/icon="uid://dofgt05scble7"

[dotnet]

project/assembly_name="Plant"

[editor]

movie_writer/fps=120

[editor_plugins]

enabled=PackedStringArray()

[global_group]

Player=""
Enemy=""

[gui]

theme/custom_font="uid://b4nwnxafcbo84"

